# --- Memory-hunt working data (regenerate with re/ram/snap.py) ---
# Savestates are ~4 MB each and the EE dumps they unpack to are 32 MB each; a
# single sweep is a quarter of a gigabyte. The manifest and the ranked
# candidates are the durable results and ARE tracked.
camera-tracking/re/ram/sweeps/**/*.p2s
camera-tracking/re/ram/sweeps/**/*.eeMemory.bin

