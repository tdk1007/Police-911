@@ -0,0 +1,174 @@
+// SPDX-FileCopyrightText: 2026 Police 911 VR fork
+// SPDX-License-Identifier: GPL-3.0+
+
+// Live VR knobs for Police 24/7 VR (pcsx2-vr fork; Earpiece decision 0005, ticket F-009).
+//
+// Three PINE opcodes, handled in PINE.cpp next to the stock ones (0x30+ is unused there):
+//
+//   MsgVRKnobSet  0x30  u8 knob, f32 value -> nothing    (clamped into the knob's range)
+//   MsgVRKnobGet  0x31  u8 knob            -> f32 value  (the value in force)
+//   MsgVRKnobList 0x32                     -> u32 count, then count x {u8 id, f32 lo, f32 hi, f32 value}
+//
+// All little endian. An unknown knob id, or a Set whose value is NaN or infinite, answers
+// IPC_FAIL like any malformed PINE command; an out-of-range value is clamped, never refused.
+// A stock PCSX2 answers IPC_FAIL to all three (its `default:` case), which is how a client
+// tells an unpatched build apart.
+//
+// Values live in host memory (atomics), not game RAM, so they survive savestate loads, resets
+// and scene changes, and need no VM. Set runs on the PINE socket thread: a store, nothing else.
+// The EE thread (OnEEVsync) and the GS thread (the flat-screen overlay) read them every vsync,
+// so a change shows one vsync later. They are seeded from [VR] in PCSX2.ini at first use; the
+// ini is never written here ("keep that" is a commit to the ini by an Earpiece worker).
+//
+// Knob ids are decision 0005's; this build serves 2 and 5 (world scale and overlay width). A
+// client treats any id missing from List as restart-only.
+//
+// Self-contained (standard library only) so vr/vr_knobs_selftest.cpp in the Police-911 repo can
+// compile and test it without the rest of PCSX2.
+
+#pragma once
+
+#include <atomic>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+namespace VRKnobs
+{
+	enum Op : std::uint8_t
+	{
+		OpSet = 0x30,
+		OpGet = 0x31,
+		OpList = 0x32,
+	};
+
+	enum Id : std::uint8_t
+	{
+		UnitsPerMetre = 2, // game units per metre: more = eyes wider apart in the game = a smaller world
+		FlatWidth = 5,     // the flat screen's width, metres (SetOverlayWidthInMeters)
+	};
+
+	struct Spec
+	{
+		std::uint8_t id;
+		float lo, hi, fallback;
+	};
+
+	// Ranges match the Earpiece adapter's table (earpiece_rig/pcsx2_adapter.py FORK_KNOBS).
+	inline constexpr Spec kSpecs[] = {
+		{UnitsPerMetre, 10.0f, 1000.0f, 100.0f},
+		{FlatWidth, 0.5f, 10.0f, 2.4f},
+	};
+	inline constexpr std::size_t kCount = sizeof(kSpecs) / sizeof(kSpecs[0]);
+	inline constexpr std::size_t kEntryBytes = 1 + 3 * 4;
+
+	inline int Index(std::uint8_t id)
+	{
+		for (std::size_t i = 0; i < kCount; i++)
+		{
+			if (kSpecs[i].id == id)
+				return static_cast<int>(i);
+		}
+		return -1;
+	}
+
+	inline float Clamp(int i, float v)
+	{
+		const Spec& s = kSpecs[i];
+		return v < s.lo ? s.lo : v > s.hi ? s.hi : v;
+	}
+
+	class Table
+	{
+	public:
+		Table()
+		{
+			for (std::size_t i = 0; i < kCount; i++)
+				m_v[i].store(kSpecs[i].fallback, std::memory_order_relaxed);
+		}
+
+		// The value from PCSX2.ini; a bad one (NaN, out of range) is clamped or ignored.
+		void Seed(std::uint8_t id, float v) { Set(id, v); }
+
+		// False for an unknown id or a value that isn't finite; otherwise clamps and stores.
+		bool Set(std::uint8_t id, float v)
+		{
+			const int i = Index(id);
+			if (i < 0 || !std::isfinite(v))
+				return false;
+			m_v[i].store(Clamp(i, v), std::memory_order_relaxed);
+			return true;
+		}
+
+		bool Get(std::uint8_t id, float* out) const
+		{
+			const int i = Index(id);
+			if (i < 0)
+				return false;
+			*out = m_v[i].load(std::memory_order_relaxed);
+			return true;
+		}
+
+		float Value(Id id) const
+		{
+			float v = 0.0f;
+			Get(id, &v);
+			return v;
+		}
+
+	private:
+		std::atomic<float> m_v[kCount];
+	};
+
+	// Bytes of arguments after the opcode, and bytes of reply payload.
+	inline constexpr std::uint32_t ArgBytes(std::uint8_t op)
+	{
+		return op == OpSet ? 5 : op == OpGet ? 1 : 0;
+	}
+	inline constexpr std::uint32_t ReplyBytes(std::uint8_t op)
+	{
+		return op == OpSet ? 0 : op == OpGet ? 4 : static_cast<std::uint32_t>(4 + kCount * kEntryBytes);
+	}
+
+	// One command. `args` holds ArgBytes(op) bytes and `out` has room for ReplyBytes(op) (the
+	// caller has bounds-checked both). False: answer IPC_FAIL.
+	inline bool Run(Table& t, std::uint8_t op, const std::uint8_t* args, std::uint8_t* out)
+	{
+		switch (op)
+		{
+			case OpSet:
+			{
+				float v;
+				std::memcpy(&v, args + 1, 4);
+				return t.Set(args[0], v);
+			}
+			case OpGet:
+			{
+				float v;
+				if (!t.Get(args[0], &v))
+					return false;
+				std::memcpy(out, &v, 4);
+				return true;
+			}
+			case OpList:
+			{
+				const std::uint32_t n = static_cast<std::uint32_t>(kCount);
+				std::memcpy(out, &n, 4);
+				out += 4;
+				for (const Spec& s : kSpecs)
+				{
+					const float v = t.Value(static_cast<Id>(s.id));
+					out[0] = s.id;
+					std::memcpy(out + 1, &s.lo, 4);
+					std::memcpy(out + 5, &s.hi, 4);
+					std::memcpy(out + 9, &v, 4);
+					out += kEntryBytes;
+				}
+				return true;
+			}
+			default:
+				return false;
+		}
+	}
+} // namespace VRKnobs
