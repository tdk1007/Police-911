+	// Earpiece replay: the clip's head pose (seated universe, as the rig recorded it from
+	// OpenVR) as the matrix WaitGetPoses would have given.
+	vr::HmdMatrix34_t FromReplay(const EarpieceReplay::DeviceInput& d)
+	{
+		float x = d.quat[0], y = d.quat[1], z = d.quat[2], w = d.quat[3];
+		const float n = std::sqrt(x * x + y * y + z * z + w * w);
