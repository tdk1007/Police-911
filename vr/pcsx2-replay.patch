+		else
+			x /= n, y /= n, z /= n, w /= n;
+		return {{{1 - 2 * (y * y + z * z), 2 * (x * y - z * w), 2 * (x * z + y * w), d.pos[0]},
+			{2 * (x * y + z * w), 1 - 2 * (x * x + z * z), 2 * (y * z - x * w), d.pos[1]},
+			{2 * (x * z - y * w), 2 * (y * z + x * w), 1 - 2 * (x * x + y * y), d.pos[2]}}};
+	}
