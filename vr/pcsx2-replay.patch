+// SPDX-FileCopyrightText: 2026 Police 911 VR fork
+// SPDX-License-Identifier: GPL-3.0+
+
+// Earpiece F-008/F-010: a frame log in every fork build, and a headless replay instance
+// (-earpiece-replay) that the Earpiece rig steps one frame at a time with a clip's input.
+#pragma once
+
+#include "common/Pcsx2Defs.h"
+
+#include <span>
+#include <string>
+#include <vector>
+
+class SettingsInterface;
+
+namespace EarpieceReplay
+{
+	struct DeviceInput
+	{
+		u32 buttons;
+		float trigger, thumb_x, thumb_y;
+		float pos[3];
+		float quat[4]; // x, y, z, w (earpiece_proto PoseSample.orientation)
+	};
+	static_assert(sizeof(DeviceInput) == 44);
+	constexpr u32 PAD_BYTES = 3 * sizeof(DeviceInput); // head, left hand, right hand
+
+	// Command line (QtHost): -earpiece-replay <port> -earpiece-data <dir>.
+	void SetPort(int port);
+	void SetDataDir(std::string dir);
+	// The flag was given at all. Enabled() is false if its port or folder is unusable; QtHost
+	// then refuses to start rather than run as a normal PCSX2 on Todd's settings.
+	bool Requested();
+	bool Enabled();
+	int PinePort();
+	const std::string& DataDir();
+
+	// QtHost::InitializeConfig, right after EmuFolders::SetDataDirectory: copy Todd's PCSX2.ini
+	// (read only) into <dir>/inis and move DataRoot/Settings to <dir>. False with a reason.
+	bool UseOwnFolders(std::string* error);
+	// After the ini is loaded: the replay overrides (own folders, no cards, Null renderer and
+	// audio, VR dry run, PINE on our port, start paused). The ini written is <dir>'s only.
+	void ApplySettings(SettingsInterface& si);
+
+	// EE thread, VSyncStart: append (g_FrameCount, QPC ns) to the log.
+	void OnVsync(u32 frame);
+	// PINE thread: drain the oldest entries that fit in `max_bytes` into `out` (u32 n, then
+	// n x {u32, u64}); the rest stay for the next ask.
+	void DrainLog(std::vector<u8>& out, size_t max_bytes);
+
+	// PINE thread: hold `pad` as the VR input, run one frame, return g_FrameCount after it once
+	// the CPU thread has stopped again. False if not a replay instance or no VM.
+	bool Step(std::span<const u8> pad, u32* frame_after);
+
+	// VRSession::OnEEVsync, when Enabled(): the held replay input instead of OpenVR.
+	const DeviceInput* Held(int device);
+} // namespace EarpieceReplay
