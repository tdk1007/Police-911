index 0000000..77991d5
--- /dev/null
+++ b/pcsx2/GS/VR/Replay.cpp
@@ -0,0 +1,251 @@
+// SPDX-FileCopyrightText: 2026 Police 911 VR fork
+// SPDX-License-Identifier: GPL-3.0+
+
+// Earpiece F-008/F-010. See Replay.h.
+#include "GS/VR/Replay.h"
+#include "Config.h"
+#include "Host.h"
+#include "VMManager.h"
+
+#include "common/Console.h"
+#include "common/Error.h"
+#include "common/FileSystem.h"
+#include "common/Path.h"
+#include "common/RedtapeWindows.h"
+#include "common/SettingsInterface.h"
+#include "common/StringUtil.h"
+
+#include "fmt/format.h"
+
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cstring>
+#include <future>
+#include <initializer_list>
+#include <mutex>
+
+namespace
+{
+	// PCSX2's own PINE and the bridge's relay: Todd's game. A replay instance never listens there.
+	constexpr int TODDS_PORTS[] = {28011, 28012};
+
+	bool s_requested = false;
+	int s_port = 0;
+	std::string s_data;
+	std::string s_todd_root; // Todd's DataRoot, read only: BIOS, patches, cheats, textures
+
+	struct Entry
+	{
+		u32 frame;
+		u64 ns;
+	};
+	static_assert(sizeof(Entry) == 16); // padded: the wire format is written field by field
+	std::mutex s_log_lock;
+	std::array<Entry, 1024> s_log;
+	size_t s_head = 0, s_count = 0;
+
+	std::mutex s_step_lock;
+	std::array<EarpieceReplay::DeviceInput, 3> s_held{};
+	std::promise<u32>* s_waiting = nullptr; // set by Step, completed by the next OnVsync
+
+	u64 QpcNs()
+	{
+		LARGE_INTEGER c, f;
+		QueryPerformanceCounter(&c);
+		QueryPerformanceFrequency(&f);
+		// Same split as CPython's perf_counter_ns (_PyTime_MulDiv), so the rig can use the value
+		// as is; no __int128, which MSVC lacks.
+		const u64 q = static_cast<u64>(c.QuadPart), fr = static_cast<u64>(f.QuadPart);
+		return (q / fr) * 1000000000ull + (q % fr) * 1000000000ull / fr;
+	}
+
+	template <typename T>
+	void Append(std::vector<u8>& out, T v)
+	{
+		const u8* p = reinterpret_cast<const u8*>(&v);
+		out.insert(out.end(), p, p + sizeof(T));
+	}
+
+	// `path` is `root` or below it. Both canonical, compared without case (Windows paths).
+	bool Inside(const std::string& path, const std::string& root)
+	{
+		if (root.empty())
+			return false;
+		std::string r = root;
+		if (r.back() != '\\' && r.back() != '/')
+			r.push_back(FS_OSPATH_SEPARATOR_CHARACTER);
+		return StringUtil::StartsWithNoCase(path + FS_OSPATH_SEPARATOR_CHARACTER, r); // equal counts too
+	}
+} // namespace
+
+void EarpieceReplay::SetPort(int port)
+{
+	s_requested = true;
+	s_port = port;
+}
+
+void EarpieceReplay::SetDataDir(std::string dir)
+{
+	s_requested = true;
+	s_data = std::move(dir);
+}
+
+bool EarpieceReplay::Requested() { return s_requested; }
+
+bool EarpieceReplay::Enabled()
+{
+	if (!s_requested || s_port <= 0 || s_port > 65535 || s_data.empty() || !Path::IsAbsolute(s_data))
+		return false;
+	for (const int p : TODDS_PORTS)
+		if (s_port == p)
+			return false;
+	return true;
+}
+
+int EarpieceReplay::PinePort() { return s_port; }
+const std::string& EarpieceReplay::DataDir() { return s_data; }
+
+bool EarpieceReplay::UseOwnFolders(std::string* error)
+{
+	const std::string data = Path::Canonicalize(s_data);
+	s_todd_root = Path::Canonicalize(EmuFolders::DataRoot);
+	// Todd's folder (portable install: next to the exe) holds his ini, cards and savestates.
+	if (Inside(data, s_todd_root) || Inside(s_todd_root, data) || Inside(data, Path::Canonicalize(EmuFolders::AppRoot)))
+	{
+		*error = fmt::format("-earpiece-data {} overlaps PCSX2's own folder {}", data, s_todd_root);
+		return false;
+	}
+	const std::string todds_ini = Path::Combine(EmuFolders::Settings, "PCSX2.ini");
+	EmuFolders::DataRoot = data;
+	EmuFolders::Settings = Path::Combine(data, "inis");
+	Error e;
+	if (!FileSystem::EnsureDirectoryExists(EmuFolders::Settings.c_str(), true, &e))
+	{
+		*error = e.GetDescription();
+		return false;
+	}
+	// Start from Todd's settings (CPU, fixes, [VR] calibration) so the replay emulates what he
+	// played; his file is only read, ours is written. A fresh copy every start: the overrides
+	// below always win, and nothing from an older replay lingers.
+	const std::string ours = Path::Combine(EmuFolders::Settings, "PCSX2.ini");
+	if (FileSystem::FileExists(todds_ini.c_str()) && !FileSystem::CopyFilePath(todds_ini.c_str(), ours.c_str(), true))
+	{
+		*error = fmt::format("can't copy {} to {}", todds_ini, ours);
+		return false;
+	}
+	Console.WriteLnFmt("Earpiece replay: data folder {}, PINE port {}", data, s_port);
+	return true;
+}
+
+void EarpieceReplay::ApplySettings(SettingsInterface& si)
+{
+	// Read-only inputs come from Todd's folders by absolute path; everything PCSX2 writes
+	// (savestates, cards, cache, logs, per-game settings) lands under our data folder.
+	for (const auto& [name, def] : std::initializer_list<std::pair<const char*, const char*>>{
+			 {"Bios", "bios"}, {"Cheats", "cheats"}, {"Patches", "patches"}, {"Textures", "textures"}, {"UserResources", "resources"}})
+	{
+		const std::string v = si.GetStringValue("Folders", name, def);
+		si.SetStringValue("Folders", name, Path::IsAbsolute(v) ? v.c_str() : Path::Combine(s_todd_root, v).c_str());
+	}
+	for (const auto& [name, def] : std::initializer_list<std::pair<const char*, const char*>>{{"Snapshots", "snaps"},
+			 {"Savestates", "sstates"}, {"MemoryCards", "memcards"}, {"Logs", "logs"}, {"Covers", "covers"},
+			 {"GameSettings", "gamesettings"}, {"Cache", "cache"}, {"InputProfiles", "inputprofiles"}, {"Videos", "videos"},
+			 {"DebuggerLayouts", "debuggerlayouts"}, {"DebuggerSettings", "debuggersettings"}})
+		si.SetStringValue("Folders", name, def);
+
+	// No memory cards: a replay must never write a save, and a card it can't see is the same
+	// card every run.
+	si.SetBoolValue("MemoryCards", "Slot1_Enable", false);
+	si.SetBoolValue("MemoryCards", "Slot2_Enable", false);
+	// No window, no sound, no OpenVR: Null renderer, Null audio, VR "dryrun" (eye tracking and
+	// pose tags without ever loading openvr_api.dll, so Todd's headset is never touched).
+	si.SetIntValue("EmuCore/GS", "Renderer", static_cast<int>(GSRendererType::Null));
+	si.SetStringValue("SPU2/Output", "Backend", "Null");
+	si.SetStringValue("VR", "Mode", "dryrun");
+	si.SetBoolValue("VR", "FakeHead", false);
+	// No controllers: Todd's pads (and the bridge's) must not reach the replay.
+	for (const char* source : {"SDL", "XInput", "DInput", "Keyboard", "Mouse"})
+		si.SetBoolValue("InputSources", source, false);
+	// Determinism: VU1 on its own thread runs ahead by host timing, so two replays could differ.
+	si.SetBoolValue("EmuCore/Speedhacks", "vuThread", false);
+	si.SetBoolValue("EmuCore", "EnablePINE", true);
+	si.SetIntValue("EmuCore", "PINESlot", s_port);
+	si.SetBoolValue("EmuCore", "EnableDiscordPresence", false);
+	si.SetBoolValue("Achievements", "Enabled", false); // hardcore mode blocks frame advance
+	si.SetBoolValue("UI", "StartPaused", true);        // only MsgReplayStep moves it
+	si.SetBoolValue("UI", "ConfirmShutdown", false);
+	si.SetBoolValue("UI", "PauseOnFocusLoss", false);
+	si.SetBoolValue("UI", "SetupWizardIncomplete", false);
+	si.SetBoolValue("AutoUpdater", "CheckAtStartup", false);
+}
+
+void EarpieceReplay::OnVsync(u32 frame)
+{
+	{
+		std::lock_guard lk(s_log_lock);
+		s_log[(s_head + s_count) % s_log.size()] = {frame, QpcNs()};
+		if (s_count < s_log.size())
+			s_count++;
+		else
+			s_head = (s_head + 1) % s_log.size();
+	}
+	std::lock_guard lk(s_step_lock);
+	if (s_waiting)
+	{
+		s_waiting->set_value(frame);
+		s_waiting = nullptr;
+	}
+}
+
+void EarpieceReplay::DrainLog(std::vector<u8>& out, size_t max_bytes)
+{
+	std::lock_guard lk(s_log_lock);
+	const size_t fit = max_bytes < 4 ? 0 : (max_bytes - 4) / 12;
+	const u32 n = static_cast<u32>(std::min(s_count, fit));
+	Append(out, n);
+	for (u32 k = 0; k < n; k++)
+	{
+		const Entry& e = s_log[(s_head + k) % s_log.size()];
+		Append(out, e.frame);
+		Append(out, e.ns);
+	}
+	s_head = (s_head + n) % s_log.size();
+	s_count -= n;
+}
+
+bool EarpieceReplay::Step(std::span<const u8> pad, u32* frame_after)
+{
+	// Only from a pause: the frame a step runs is then always the one after the last stop.
+	if (!Enabled() || pad.size() != PAD_BYTES || VMManager::GetState() != VMState::Paused)
+		return false;
+	std::promise<u32> done;
+	auto got = done.get_future();
+	{
+		std::lock_guard lk(s_step_lock);
+		std::memcpy(s_held.data(), pad.data(), PAD_BYTES);
+		s_waiting = &done;
+	}
+	// PCSX2's own frame advance: one frame, then it pauses itself in the next VSyncStart.
+	Host::RunOnCPUThread([] { VMManager::FrameAdvance(1); });
+	if (got.wait_for(std::chrono::seconds(10)) != std::future_status::ready)
+	{
+		std::lock_guard lk(s_step_lock);
+		if (s_waiting == &done)
+		{
+			s_waiting = nullptr;
+			return false; // the VM went away or never ran
+		}
+	}
+	*frame_after = got.get();
+	// OnVsync fires inside VSyncStart, after the pause was requested but before the CPU
+	// thread has left it; this no-op only runs once that thread is back in its paused loop,
+	// so a memory read after the reply sees the stopped frame, not one still moving.
+	Host::RunOnCPUThread([] {}, true);
+	return VMManager::GetState() == VMState::Paused;
+}
+
+const EarpieceReplay::DeviceInput* EarpieceReplay::Held(int device)
+{
+	return Enabled() && device >= 0 && device < 3 ? &s_held[device] : nullptr;
+}
