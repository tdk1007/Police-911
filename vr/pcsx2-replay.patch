new file mode 100644
--- /dev/null
+++ b/pcsx2/VR/Replay.h
@@ -0,0 +1,38 @@
+// Earpiece F-008: frame log for every fork build, headless input replay for -earpiece-replay.
+#pragma once
+
+#include "common/Pcsx2Types.h"
+
+#include <span>
+#include <vector>
+
+namespace EarpieceReplay
+{
+	struct DeviceInput
+	{
+		u32 buttons;
+		float trigger, thumb_x, thumb_y;
+		float pos[3];
+		float quat[4];
+	};
+	static_assert(sizeof(DeviceInput) == 44);
+	constexpr u32 PAD_BYTES = 3 * sizeof(DeviceInput); // head, left hand, right hand
+
+	// Command line: -earpiece-replay <port> -earpiece-data <dir>. Parsed before VM start.
+	bool ParseArg(std::span<const char* const> args, size_t& i);
+	bool Enabled();
+	int PinePort();
+
+	// EE thread, VSyncStart: append (g_FrameCount, QPC ns) to the log.
+	void OnVsync(u32 frame);
+	// PINE thread: drain the log into `out` (u32 n, then n x {u32, u64}).
+	void DrainLog(std::vector<u8>& out);
+
+	// PINE thread: hold `pad` as the VR input, run one frame, return g_FrameCount after it.
+	// False if not a replay instance or no VM.
+	bool Step(std::span<const u8> pad, u32* frame_after);
+
+	// VR input path (VRSession), when Enabled(): the held replay input instead of OpenVR.
+	const DeviceInput* Held(int device);
+} // namespace EarpieceReplay
diff --git a/pcsx2/VR/Replay.cpp b/pcsx2/VR/Replay.cpp
new file mode 100644
--- /dev/null
+++ b/pcsx2/VR/Replay.cpp
@@ -0,0 +1,127 @@
+// Earpiece F-008. See Replay.h.
+#include "PrecompiledHeader.h"
+
+#include "VR/Replay.h"
+#include "Counters.h"
+#include "VMManager.h"
+
+#include <windows.h>
+
+#include <array>
+#include <atomic>
+#include <cstring>
+#include <future>
+#include <mutex>
+#include <string>
+#include <thread>
+
+namespace
+{
+	bool s_enabled = false;
+	int s_port = 0;
+	std::string s_data;
+
+	struct Entry
+	{
+		u32 frame;
+		u64 ns;
+	};
+	std::mutex s_log_lock;
+	std::array<Entry, 1024> s_log;
+	size_t s_head = 0, s_count = 0;
+
+	std::array<EarpieceReplay::DeviceInput, 3> s_held{};
+	std::promise<u32>* s_waiting = nullptr; // set by Step, completed by the next OnVsync
+	std::mutex s_step_lock;
+
+	u64 QpcNs()
+	{
+		LARGE_INTEGER c, f;
+		QueryPerformanceCounter(&c);
+		QueryPerformanceFrequency(&f);
+		// Same split as CPython's perf_counter_ns (_PyTime_MulDiv), so the rig can use the value
+		// as is; no __int128, which MSVC lacks.
+		const u64 q = static_cast<u64>(c.QuadPart), fr = static_cast<u64>(f.QuadPart);
+		return (q / fr) * 1000000000ull + (q % fr) * 1000000000ull / fr;
+	}
+} // namespace
+
+bool EarpieceReplay::ParseArg(std::span<const char* const> args, size_t& i)
+{
+	const std::string a = args[i];
+	if (a == "-earpiece-replay" && i + 1 < args.size())
+	{
+		s_port = std::atoi(args[++i]);
+		s_enabled = s_port > 0 && s_port != 28011 && s_port != 28012; // never Todd's ports
+		return true;
+	}
+	if (a == "-earpiece-data" && i + 1 < args.size())
+	{
+		s_data = args[++i];
+		return true;
+	}
+	return false;
+}
+
+bool EarpieceReplay::Enabled() { return s_enabled && !s_data.empty(); }
+int EarpieceReplay::PinePort() { return s_port; }
+
+void EarpieceReplay::OnVsync(u32 frame)
+{
+	{
+		std::lock_guard lk(s_log_lock);
+		s_log[(s_head + s_count) % s_log.size()] = {frame, QpcNs()};
+		if (s_count < s_log.size())
+			s_count++;
+		else
+			s_head = (s_head + 1) % s_log.size();
+	}
+	if (Enabled())
+	{
+		std::lock_guard lk(s_step_lock);
+		if (s_waiting)
+		{
+			s_waiting->set_value(frame);
+			s_waiting = nullptr;
+		}
+	}
+}
+
+void EarpieceReplay::DrainLog(std::vector<u8>& out)
+{
+	std::lock_guard lk(s_log_lock);
+	const u32 n = static_cast<u32>(s_count);
+	out.insert(out.end(), reinterpret_cast<const u8*>(&n), reinterpret_cast<const u8*>(&n) + 4);
+	for (size_t k = 0; k < s_count; k++)
+	{
+		const Entry& e = s_log[(s_head + k) % s_log.size()];
+		out.insert(out.end(), reinterpret_cast<const u8*>(&e.frame), reinterpret_cast<const u8*>(&e.frame) + 4);
+		out.insert(out.end(), reinterpret_cast<const u8*>(&e.ns), reinterpret_cast<const u8*>(&e.ns) + 8);
+	}
+	s_head = s_count = 0;
+}
+
+bool EarpieceReplay::Step(std::span<const u8> pad, u32* frame_after)
+{
+	if (!Enabled() || pad.size() != PAD_BYTES || !VMManager::HasValidVM())
+		return false;
+	std::promise<u32> done;
+	auto got = done.get_future();
+	{
+		std::lock_guard lk(s_step_lock);
+		std::memcpy(s_held.data(), pad.data(), PAD_BYTES);
+		s_waiting = &done;
+	}
+	// PCSX2's own frame advance runs one frame and pauses on the CPU thread; the reply waits
+	// for that pause too, so memory read after a step can't have moved on.
+	VMManager::FrameAdvance(1);
+	*frame_after = got.get();
+	while (VMManager::GetState() != VMState::Paused)
+		std::this_thread::yield();
+	return true;
+}
+
+const EarpieceReplay::DeviceInput* EarpieceReplay::Held(int device)
+{
+	return Enabled() && device >= 0 && device < 3 ? &s_held[device] : nullptr;
+}
