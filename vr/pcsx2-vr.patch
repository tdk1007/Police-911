+// Eye pairing. The GS runs one packet behind the EE, and every vsync it draws the two eye
+// frames into the two buffers in a fixed order. Snapshots are taken when a buffer is about
+// to be drawn over, so at vsync the buffer drawn second has a snapshot one pass newer than
+// the other: pair its PREVIOUS snapshot with the other's current one. Both then come from
+// the same EE vsync (same sim tick, same head pose).
+bool GSRendererHW::GetVREyes(const u32 tbp[2], GSTexture* tex[2], float scale[2])
+{
+	const VREyeSnap* s[2] = {FindVRSnap(tbp[0]), FindVRSnap(tbp[1])};
+	if (!s[0] || !s[1])
+		return false;
+	const int ahead = (s[0]->seq > s[1]->seq) ? 0 : 1;
+	for (int eye = 0; eye < 2; eye++)
+	{
+		const int which = (eye == ahead) ? (s[eye]->cur ^ 1) : s[eye]->cur;
+		tex[eye] = s[eye]->tex[which];
+		scale[eye] = s[eye]->scale;
+		if (!tex[eye])
+			return false;
+	}
+	return true;
+}
+
+const GSRendererHW::VREyeSnap* GSRendererHW::FindVRSnap(u32 tbp) const
+{
+	for (const VREyeSnap& s : m_vr_snap)
+	{
+		if (s.tbp == tbp)
+			return &s;
+	}
+	return nullptr;
+}
+
+void GSRendererHW::VRSnapshot(u32 tbp)
+{
+	// Only an existing target that starts exactly here; never create one.
+	GSTextureCache::Target* rt = g_texture_cache->FindOverlappingTarget(tbp, tbp + 1);
+	if (!rt || rt->m_TEX0.TBP0 != tbp || !rt->m_texture)
+		return;
+
+	VREyeSnap* s = const_cast<VREyeSnap*>(FindVRSnap(tbp));
+	if (!s)
+	{
+		// Reuse the least recently written slot.
+		s = (m_vr_snap[0].seq <= m_vr_snap[1].seq) ? &m_vr_snap[0] : &m_vr_snap[1];
+		s->tbp = tbp;
+	}
+
+	GSTexture* src = rt->m_texture;
+	s->cur ^= 1;
+	GSTexture*& dst = s->tex[s->cur];
+	if (!dst || dst->GetSize() != src->GetSize() || dst->GetFormat() != src->GetFormat())
+	{
+		if (dst)
+			g_gs_device->Recycle(dst);
+		dst = g_gs_device->CreateRenderTarget(src->GetWidth(), src->GetHeight(), src->GetFormat(), false);
+		if (!dst)
+			return;
+	}
+	g_gs_device->CopyRect(src, dst, GSVector4i::loadh(src->GetSize()), 0, 0);
+	s->scale = rt->m_scale;
+	s->seq = ++m_vr_snap_seq;
+}
+
+void GSRendererHW::VRReleaseSnapshots()
+{
+	for (VREyeSnap& s : m_vr_snap)
+	{
+		for (GSTexture* t : s.tex)
+		{
+			if (t)
+				g_gs_device->Recycle(t);
+		}
+		s = {};
+	}
+}
