+// VR fork: replace the merged output with eye L | eye R, both fetched from the
+// texture cache (see GS/VR/VRStereo.h for why the two display buffers are the eyes).
+void GSRenderer::VRCompose()
+{
+	static VRStereo::BufferTracker s_tracker;
+
+	const int idx = PCRTCDisplays.PCRTCDisplays[1].enabled ? 1 : 0;
+	const GSPCRTCRegs::PCRTCDisplay& disp = PCRTCDisplays.PCRTCDisplays[idx];
+	GSTexture* out = g_gs_device->GetCurrent();
+	if (!disp.enabled || disp.FBW == 0 || !out)
+		return;
+
+	u32 tbp[2];
+	const bool tracked = s_tracker.Track(disp.Block(), tbp);
+	const bool openvr = VRStereo::GetSettings().mode == VRStereo::Mode::OpenVR;
+
+	// Menus, title, loading: no world view, so no stereo. Show the normal picture flat
+	// (headset: world-locked screen; desktop: left as it is).
+	if (!VRSession::WorldActive())
+	{
+		static constexpr float whole[4] = {0.0f, 0.0f, 1.0f, 1.0f}; // the merge target is the picture's size
+		if (openvr)
+			VRSession::PresentFlat(out, whole);
+		return;
+	}
+
+	GSTexture* eyes[2];
+	float scale[2];
+	if (!tracked || !GetVREyes(tbp, eyes, scale))
+		return;
+
+	static u32 s_vs;
+	const bool dump = VRStereo::GetSettings().dump_eyes && (++s_vs % 450) == 0; // logs/vr_eye{0,1}.png every 5 s
+	const GSVector4 out_size = GSVector4(out->GetSize()).xyxy();
+	float uv[2][4];
+	for (int eye = 0; eye < 2; eye++)
+	{
+		const GSVector4 src = (GSVector4(disp.framebufferRect) * GSVector4(scale[eye])) / GSVector4(eyes[eye]->GetSize()).xyxy();
+		GSVector4::store<false>(uv[eye], src);
+	}
+	if (openvr)
+		VRSession::Present(eyes, uv);
+
+	// Desktop mirror: L | R
+	for (int eye = 0; eye < 2; eye++)
+	{
+		GSTexture* t = eyes[eye];
+		const GSVector4 src = GSVector4::load<false>(uv[eye]);
+		const GSVector4 dst = GSVector4(0.5f * eye, 0.0f, 0.5f * (eye + 1), 1.0f) * out_size;
+		g_gs_device->StretchRect(t, src, out, dst, ShaderConvert::COPY, true);
+		if (dump)
+			t->Save(Path::Combine(EmuFolders::Logs, fmt::format("vr_eye{}.png", eye)));
+	}
+}
