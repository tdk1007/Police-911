{
  "controller_type": "frame_controller",
  "name": "Police 24/7 bridge - Steam Frame",
  "description": "Right trigger fires, right grip recenters, left d-pad down = push-to-talk; right B loads the selected savestate, left d-pad left/right picks the slot, left d-pad up saves to slot 1",
  "bindings": {
    "/actions/bridge": {
      "sources": [
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "trigger",
          "inputs": {
            "pull": {
              "output": "/actions/bridge/in/fire"
            }
          }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/bridge/in/recenter"
            }
          }
        },
        {
          "path": "/user/hand/left/input/dpad_down",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/bridge/in/talk"
            }
          }
        },
        {
          "path": "/user/hand/right/input/b",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/bridge/in/loadstate"
            }
          }
        },
        {
          "path": "/user/hand/left/input/dpad_up",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/bridge/in/savestate"
            }
          }
        },
        {
          "path": "/user/hand/left/input/dpad_right",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/bridge/in/slot_next"
            }
          }
        },
        {
          "path": "/user/hand/left/input/dpad_left",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/bridge/in/slot_prev"
            }
          }
        }
      ],
      "haptics": [
        {
          "output": "/actions/bridge/out/haptic",
          "path": "/user/hand/left/output/haptic"
        },
        {
          "output": "/actions/bridge/out/haptic",
          "path": "/user/hand/right/output/haptic"
        }
      ],
      "poses": [
        {
          "output": "/actions/bridge/in/aim",
          "path": "/user/hand/right/pose/tip"
        }
      ]
    }
  }
}