{
  "controller_type": "frame_controller",
  "name": "Police 24/7 bridge - Steam Frame",
  "description": "Right trigger fires, right grip recenters, left d-pad down / right A = push-to-talk",
  "bindings": {
    "/actions/bridge": {
      "sources": [
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "trigger",
          "inputs": {
            "pull": {
              "output": "/actions/bridge/in/fire"
            }
          }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/bridge/in/recenter"
            }
          }
        },
        {
          "path": "/user/hand/left/input/dpad_down",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/bridge/in/talk"
            }
          }
        },
        {
          "path": "/user/hand/right/input/a",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/bridge/in/talk"
            }
          }
        }
      ],
      "haptics": [
        {
          "output": "/actions/bridge/out/haptic",
          "path": "/user/hand/left/output/haptic"
        },
        {
          "output": "/actions/bridge/out/haptic",
          "path": "/user/hand/right/output/haptic"
        }
      ],
      "poses": [
        {
          "output": "/actions/bridge/in/aim",
          "path": "/user/hand/right/pose/tip"
        }
      ]
    }
  }
}